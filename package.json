{
  "name": "hggui",
  "version": "0.1.27",
  "description": "",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "debug": "electron --trace-warnings .",
    "stress-test": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/HGMDEngine.stresstest.js",
    "rule-test": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/hgmd.test.js",
    "empty-line-test": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/hgmd.empty-newline.test.js",
    "bench-search": "node --expose-gc --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/projectManager.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liiesl/holy-grail-gui.git"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^28.0.0"
  },
  "build": {
    "appId": "com.github.liiesl.hggui",
    "productName": "Holy Grail Text Editor",
    "publish": {
      "provider": "github",
      "owner": "liiesl",
      "repo": "holy-grail-gui"
    },
    "files": [
      "src/**/*",
      "package.json",
      "external/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@mistralai/mistralai": "^1.13.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3"
  }
}
