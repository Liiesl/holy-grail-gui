{
  "name": "hggui",
  "version": "0.1.24",
  "description": "",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "debug": "electron --trace-warnings .",
    "stress-test": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/HGMDEngine.stresstest.js",
    "rule-test": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/hgmd.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liiesl/holy-grail-gui.git"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "jest": "^30.1.3"
  },
  "build": {
    "appId": "com.github.liiesl.hggui",
    "productName": "Holy Grail Text Editor",
    "publish": {
      "provider": "github",
      "owner": "liiesl",
      "repo": "holy-grail-gui"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  }
}